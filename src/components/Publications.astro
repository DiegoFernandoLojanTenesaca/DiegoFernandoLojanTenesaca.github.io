---
const publications = [
  {
    key: "cit2026",
    year: "2026",
    authors: "Lojan Tenesaca, D. F.",
  },
];
---

<section id="publicaciones" class="py-16 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto">
    <div class="reveal mb-10">
      <h2 class="text-3xl sm:text-4xl font-bold mb-3">
        <span class="gradient-text" data-i18n="pub.title">Publicaciones</span>
      </h2>
      <p class="text-text-muted" data-i18n="pub.subtitle">
        Investigación aceptada y publicada en venues con revisión por pares.
      </p>
    </div>

    <ol class="reveal-stagger space-y-8">
      {publications.map((pub) => (
        <li class="grid sm:grid-cols-[5rem_1fr] gap-2 sm:gap-6">
          <span class="font-mono text-sm text-accent pt-1">{pub.year}</span>
          <div>
            <h3
              class="text-text font-medium leading-snug mb-2"
              data-i18n={`pub.${pub.key}.title`}
            >
              Bayesian Hyperparameter Optimization of Support Vector Machines Using TPE for
              Stress Detection in Spanish Social Media During the 2024 Ecuadorian Energy Crisis
            </h3>
            <p class="text-sm text-text-muted mb-1">{pub.authors}</p>
            <p
              class="text-sm text-text-muted italic mb-3"
              data-i18n={`pub.${pub.key}.venue`}
            >
              Emerging Research in Intelligent Systems · Proceedings of the CIT 2026 · Springer Nature
            </p>
            <span class="inline-flex items-center gap-2 text-xs font-mono text-accent border border-accent/40 rounded px-2 py-1">
              <span class="w-1.5 h-1.5 rounded-full bg-accent timeline-dot-active"></span>
              <span data-i18n={`pub.${pub.key}.status`}>Aceptado, en producción</span>
            </span>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
