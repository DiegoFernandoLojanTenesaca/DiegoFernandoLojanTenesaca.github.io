---

---

<section id="inicio" class="relative min-h-[85vh] flex items-center overflow-hidden pt-20 pb-12">
  <!-- Background orbs (subtle) -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="hero-gradient-orb absolute top-1/3 -left-40 w-72 h-72 bg-accent/6 rounded-full blur-3xl"></div>
    <div class="hero-gradient-orb absolute bottom-1/4 right-0 w-64 h-64 bg-accent-light/5 rounded-full blur-3xl" style="animation-delay: 3s;"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Left: Text content -->
      <div class="text-left">
        <div class="hero-animate hero-delay-1 flex items-end gap-3 mb-4">
          <img
            id="hero-avatar"
            src={`${import.meta.env.BASE_URL}avatar-body.png`}
            alt=""
            class="w-16 h-16 sm:w-20 sm:h-20 cursor-pointer select-none transition-transform"
            style="image-rendering: pixelated;"
          />
          <p class="text-accent-light font-mono text-sm tracking-wider">
            &lt;developer /&gt;
          </p>
        </div>

        <h1 class="hero-animate hero-delay-2 text-4xl sm:text-5xl lg:text-6xl font-extrabold mb-3 tracking-tight leading-tight">
          Diego Fernando
          <span class="gradient-text block">Lojan Tenesaca</span>
        </h1>

        <h2 class="hero-animate hero-delay-3 text-lg sm:text-xl text-text-muted font-light mb-6">
          Full Stack Developer <span class="text-accent font-normal">|</span> Data & AI Engineer
        </h2>

        <p class="hero-animate hero-delay-4 max-w-lg text-text-muted text-base leading-relaxed mb-8" data-i18n="hero.tagline">
          De la arquitectura de software a los modelos de IA. Diseño, construyo y despliego
          sistemas completos que resuelven problemas reales en producción.
        </p>

        <div class="hero-animate hero-delay-5 flex flex-col sm:flex-row items-start gap-4">
          <a
            href="#proyectos"
            class="group inline-flex items-center gap-2 px-6 py-3 bg-accent-light text-bg font-semibold rounded-lg hover:brightness-110 transition-all duration-300 hover:shadow-lg hover:shadow-accent/25"
          >
            <span data-i18n="hero.cta.projects">Ver Proyectos</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="#contacto"
            class="inline-flex items-center gap-2 px-6 py-3 border border-border text-text-muted font-medium rounded-lg hover:border-accent hover:text-accent-light transition-all duration-300"
            data-i18n="hero.cta.contact"
          >
            Contáctame
          </a>
          <a
            id="cv-link"
            href={`${import.meta.env.BASE_URL}cv_lojan_diego_es.pdf`}
            target="_blank"
            rel="noopener noreferrer"
            download
            class="inline-flex items-center gap-2 px-6 py-3 text-text-muted font-medium hover:text-accent-light transition-colors duration-300"
            data-i18n="hero.cta.cv"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Descargar CV
          </a>
        </div>
      </div>

      <!-- Right: Terminal widget with rotating snippets -->
      <div class="hero-animate hero-delay-3 hidden lg:block">
        <div class="terminal-window bg-surface border border-border rounded-xl overflow-hidden shadow-2xl shadow-black/30">
          <!-- Terminal top bar -->
          <div class="flex items-center gap-2 px-4 py-3 bg-surface-light border-b border-border">
            <div class="w-3 h-3 rounded-full bg-[#ff5f57]"></div>
            <div class="w-3 h-3 rounded-full bg-[#ffbd2e]"></div>
            <div class="w-3 h-3 rounded-full bg-[#28c840]"></div>
            <span id="terminal-filename" class="ml-3 text-xs text-text-muted font-mono">semantic_search.py</span>
          </div>

          <!-- Snippet containers -->
          <div class="relative" style="min-height: 290px;">
            <div class="snippet-panel snippet-active p-5 font-mono text-[13px] leading-relaxed" data-file="semantic_search.py">
              <div class="terminal-line tl-1"><span class="text-accent">from</span> pgvector.sqlalchemy <span class="text-accent">import</span> Vector</div>
              <div class="terminal-line tl-2"><span class="text-accent">from</span> fastapi <span class="text-accent">import</span> FastAPI</div>
              <div class="terminal-line tl-3">&nbsp;</div>
              <div class="terminal-line tl-4">app = <span class="text-accent-light">FastAPI</span>(title=<span class="text-[#a3e635]">"Sudial AI"</span>)</div>
              <div class="terminal-line tl-5">&nbsp;</div>
              <div class="terminal-line tl-6"><span class="text-accent">@</span><span class="text-accent-light">app.post</span>(<span class="text-[#a3e635]">"/query"</span>)</div>
              <div class="terminal-line tl-7"><span class="text-accent">async def</span> <span class="text-accent-light">semantic_search</span>(q: <span class="text-accent-light">str</span>):</div>
              <div class="terminal-line tl-8">&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-accent">return await</span> retriever.<span class="text-accent-light">ainvoke</span>(q)</div>
              <div class="terminal-line tl-9">&nbsp;</div>
              <div class="terminal-line tl-10"><span class="term-prompt">$</span> curl -s /query -d <span class="text-[#a3e635]">&#39;&#123;"q":"factura"&#125;&#39;</span></div>
              <div class="terminal-line tl-11"><span class="term-out">&rarr; 139.000 conversaciones &middot; BGE-M3 &middot; HNSW</span></div>
              <div class="terminal-line tl-12"><span class="term-out">&rarr; 18 dominios &middot; 15 tools &middot; &lt; 2 s</span></div>
              <div class="terminal-line tl-13"><span class="terminal-cursor"></span></div>
            </div>

            <div class="snippet-panel p-5 font-mono text-[13px] leading-relaxed" data-file="consensus.py">
              <div class="terminal-line tl-1"><span class="text-accent">from</span> sklearn.ensemble <span class="text-accent">import</span> IsolationForest</div>
              <div class="terminal-line tl-2"><span class="text-accent">from</span> statsmodels.tsa.seasonal <span class="text-accent">import</span> STL</div>
              <div class="terminal-line tl-3">&nbsp;</div>
              <div class="terminal-line tl-4"><span class="text-accent">def</span> <span class="text-accent-light">detect_anomalies</span>(serie):</div>
              <div class="terminal-line tl-5">&nbsp;&nbsp;&nbsp;&nbsp;votos = <span class="text-accent-light">isolation_forest</span>(serie)</div>
              <div class="terminal-line tl-6">&nbsp;&nbsp;&nbsp;&nbsp;votos += <span class="text-accent-light">stl_residual</span>(serie)</div>
              <div class="terminal-line tl-7">&nbsp;&nbsp;&nbsp;&nbsp;votos += <span class="text-accent-light">cusum_bilateral</span>(serie)</div>
              <div class="terminal-line tl-8">&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-accent">return</span> votos &gt;= <span class="text-text-muted">2</span></div>
              <div class="terminal-line tl-9">&nbsp;</div>
              <div class="terminal-line tl-10"><span class="term-prompt">$</span> python consensus.py --pais EC</div>
              <div class="terminal-line tl-11"><span class="term-out">&rarr; crisis energ&eacute;tica 2024 detectada</span></div>
              <div class="terminal-line tl-12"><span class="term-out">&rarr; F1 = 0.750 &middot; consenso de 3 algoritmos</span></div>
              <div class="terminal-line tl-13"><span class="terminal-cursor"></span></div>
            </div>

            <div class="snippet-panel p-5 font-mono text-[13px] leading-relaxed" data-file="stress_svm.py">
              <div class="terminal-line tl-1"><span class="text-accent">import</span> optuna</div>
              <div class="terminal-line tl-2"><span class="text-accent">from</span> sklearn.svm <span class="text-accent">import</span> SVC</div>
              <div class="terminal-line tl-3">&nbsp;</div>
              <div class="terminal-line tl-4">study = optuna.<span class="text-accent-light">create_study</span>(</div>
              <div class="terminal-line tl-5">&nbsp;&nbsp;&nbsp;&nbsp;sampler=optuna.samplers.<span class="text-accent-light">TPESampler</span>(),</div>
              <div class="terminal-line tl-6">&nbsp;&nbsp;&nbsp;&nbsp;direction=<span class="text-[#a3e635]">"maximize"</span></div>
              <div class="terminal-line tl-7">)</div>
              <div class="terminal-line tl-8">study.<span class="text-accent-light">optimize</span>(objective, n_trials=<span class="text-text-muted">200</span>)</div>
              <div class="terminal-line tl-9">&nbsp;</div>
              <div class="terminal-line tl-10"><span class="term-prompt">$</span> python train.py --emb fasttext</div>
              <div class="terminal-line tl-11"><span class="term-out">&rarr; detecci&oacute;n de estr&eacute;s &middot; tweets crisis 2024</span></div>
              <div class="terminal-line tl-12"><span class="term-out">&rarr; aceptado &middot; CIT 2026 &middot; Springer Nature</span></div>
              <div class="terminal-line tl-13"><span class="terminal-cursor"></span></div>
            </div>

            <div class="snippet-panel p-5 font-mono text-[13px] leading-relaxed" data-file="reembed.py">
              <div class="terminal-line tl-1"><span class="text-accent">from</span> text_embeddings <span class="text-accent">import</span> TEIClient</div>
              <div class="terminal-line tl-2">&nbsp;</div>
              <div class="terminal-line tl-3"><span class="text-accent">async def</span> <span class="text-accent-light">reembed</span>(batch):</div>
              <div class="terminal-line tl-4">&nbsp;&nbsp;&nbsp;&nbsp;vectors = <span class="text-accent">await</span> tei.<span class="text-accent-light">embed</span>(batch, model=<span class="text-[#a3e635]">"BGE-M3"</span>)</div>
              <div class="terminal-line tl-5">&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-accent">await</span> db.<span class="text-accent-light">copy_records</span>(vectors)</div>
              <div class="terminal-line tl-6">&nbsp;</div>
              <div class="terminal-line tl-7"><span class="text-accent">await</span> <span class="text-accent-light">run_workers</span>(concurrency=<span class="text-text-muted">8</span>)</div>
              <div class="terminal-line tl-8">&nbsp;</div>
              <div class="terminal-line tl-9"><span class="term-prompt">$</span> python reembed.py --gpu A6000</div>
              <div class="terminal-line tl-10"><span class="term-out">&rarr; 62.000 conversaciones re-embebidas</span></div>
              <div class="terminal-line tl-11"><span class="term-out">&rarr; &lt; 1 h &middot; &iacute;ndice HNSW reconstruido</span></div>
              <div class="terminal-line tl-12">&nbsp;</div>
              <div class="terminal-line tl-13"><span class="terminal-cursor"></span></div>
            </div>

            <div class="snippet-panel p-5 font-mono text-[13px] leading-relaxed" data-file="agent.py">
              <div class="terminal-line tl-1"><span class="text-accent">from</span> langgraph.graph <span class="text-accent">import</span> StateGraph</div>
              <div class="terminal-line tl-2">&nbsp;</div>
              <div class="terminal-line tl-3">graph = <span class="text-accent-light">StateGraph</span>(AgentState)</div>
              <div class="terminal-line tl-4">graph.<span class="text-accent-light">add_node</span>(<span class="text-[#a3e635]">"router"</span>, clasificar_intencion)</div>
              <div class="terminal-line tl-5">graph.<span class="text-accent-light">add_node</span>(<span class="text-[#a3e635]">"tools"</span>, ejecutar_herramientas)</div>
              <div class="terminal-line tl-6">graph.<span class="text-accent-light">add_conditional_edges</span>(<span class="text-[#a3e635]">"router"</span>, decidir)</div>
              <div class="terminal-line tl-7">&nbsp;</div>
              <div class="terminal-line tl-8">agente = graph.<span class="text-accent-light">compile</span>(checkpointer=postgres)</div>
              <div class="terminal-line tl-9">&nbsp;</div>
              <div class="terminal-line tl-10"><span class="term-prompt">$</span> wauto --canal whatsapp</div>
              <div class="terminal-line tl-11"><span class="term-out">&rarr; WhatsApp &middot; Telegram &middot; Meta</span></div>
              <div class="terminal-line tl-12"><span class="term-out">&rarr; 5 planes en producci&oacute;n &middot; respuesta &lt; 2 s</span></div>
              <div class="terminal-line tl-13"><span class="terminal-cursor"></span></div>
            </div>
          </div>
        </div>
      </div>

      <script is:inline>
        (function() {
          if (window.__terminalInterval) clearInterval(window.__terminalInterval);
          var panels = document.querySelectorAll(".snippet-panel");
          var filenameEl = document.getElementById("terminal-filename");
          if (!panels.length || !filenameEl) return;
          var current = 0;
          window.__terminalInterval = setInterval(function() {
            panels[current].classList.remove("snippet-active");
            current = (current + 1) % panels.length;
            panels[current].classList.add("snippet-active");
            filenameEl.textContent = panels[current].getAttribute("data-file") || "";
          }, 6000);
        })();
      </script>

      <!-- Easter egg: clicks en el avatar -->
      <script is:inline>
        (function () {
          var avatar = document.getElementById("hero-avatar");
          if (!avatar) return;
          var clicks = 0;
          var resetTimer = null;
          var messages = [
            "👋 ¡Hola! Tienes buen ojo.",
            "🔍 Sigues curioso, eh.",
            "🚀 Casi lo tienes...",
            "⚡ Una más...",
            "🎮 Si juegas LoL o quieres charlar, escríbeme: \"lautish\" — mi nick. ¡GLHF!"
          ];

          function showToast(msg) {
            var t = document.createElement("div");
            t.textContent = msg;
            t.style.cssText = "position:fixed;bottom:32px;left:50%;transform:translateX(-50%) translateY(20px);background:rgba(16,185,129,0.95);color:#0a0e13;padding:12px 24px;border-radius:12px;font-family:monospace;font-size:14px;font-weight:600;z-index:9999;box-shadow:0 10px 40px rgba(0,0,0,0.4);opacity:0;transition:all 0.3s ease;backdrop-filter:blur(10px);";
            document.body.appendChild(t);
            requestAnimationFrame(function () {
              t.style.opacity = "1";
              t.style.transform = "translateX(-50%) translateY(0)";
            });
            setTimeout(function () {
              t.style.opacity = "0";
              t.style.transform = "translateX(-50%) translateY(20px)";
              setTimeout(function () { t.remove(); }, 300);
            }, 2500);
          }

          avatar.addEventListener("click", function () {
            clicks++;
            avatar.style.transform = "scale(1.15) rotate(" + (clicks * 7) + "deg)";
            setTimeout(function () { avatar.style.transform = ""; }, 200);

            if (clicks >= 1 && clicks <= messages.length) {
              showToast(messages[clicks - 1]);
            }

            if (clicks === messages.length) {
              // Confetti barato 🎊
              for (var i = 0; i < 24; i++) {
                (function (i) {
                  setTimeout(function () {
                    var c = document.createElement("div");
                    var colors = ["#10b981", "#34d399", "#fbbf24", "#f43f5e", "#8b5cf6"];
                    var color = colors[Math.floor(Math.random() * colors.length)];
                    c.style.cssText = "position:fixed;top:50%;left:50%;width:10px;height:10px;background:" + color + ";border-radius:2px;pointer-events:none;z-index:9998;";
                    document.body.appendChild(c);
                    var dx = (Math.random() - 0.5) * 600;
                    var dy = (Math.random() - 0.5) * 600;
                    c.animate(
                      [
                        { transform: "translate(0,0) rotate(0deg)", opacity: 1 },
                        { transform: "translate(" + dx + "px," + dy + "px) rotate(720deg)", opacity: 0 }
                      ],
                      { duration: 1200, easing: "cubic-bezier(0.2,0.6,0.3,1)" }
                    );
                    setTimeout(function () { c.remove(); }, 1300);
                  }, i * 30);
                })(i);
              }
              clicks = 0;
            }

            clearTimeout(resetTimer);
            resetTimer = setTimeout(function () { clicks = 0; }, 3000);
          });
        })();
      </script>

    </div>
  </div>
</section>

<style>
  /* Snippet panels: only active one is visible */
  .snippet-panel {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .snippet-panel.snippet-active {
    position: relative;
    opacity: 1;
    pointer-events: auto;
  }

  /* Re-trigger line animations when panel becomes active */
  .snippet-active .terminal-line {
    opacity: 0;
    animation: terminal-type 0.25s ease forwards;
    white-space: pre;
  }

  .snippet-active .tl-1  { animation-delay: 0.15s; }
  .snippet-active .tl-2  { animation-delay: 0.30s; }
  .snippet-active .tl-3  { animation-delay: 0.42s; }
  .snippet-active .tl-4  { animation-delay: 0.54s; }
  .snippet-active .tl-5  { animation-delay: 0.66s; }
  .snippet-active .tl-6  { animation-delay: 0.78s; }
  .snippet-active .tl-7  { animation-delay: 0.90s; }
  .snippet-active .tl-8  { animation-delay: 1.02s; }
  .snippet-active .tl-9  { animation-delay: 1.14s; }
  .snippet-active .tl-10 { animation-delay: 1.26s; }
  .snippet-active .tl-11 { animation-delay: 1.38s; }
  .snippet-active .tl-12 { animation-delay: 1.50s; }
  .snippet-active .tl-13 { animation-delay: 1.62s; }

  .term-out {
    color: #a3e635;
  }

  .term-prompt {
    color: var(--color-accent-light);
  }

  /* Hide lines in non-active panels */
  .snippet-panel:not(.snippet-active) .terminal-line {
    opacity: 0;
    animation: none;
  }

  @keyframes terminal-type {
    0% {
      opacity: 0;
      transform: translateX(-4px);
    }
    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Blinking cursor */
  .terminal-cursor {
    display: inline-block;
    width: 8px;
    height: 18px;
    background-color: var(--color-accent);
    animation: cursor-blink 1s step-end infinite;
    vertical-align: text-bottom;
  }

  @keyframes cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Terminal window subtle glow */
  .terminal-window {
    position: relative;
  }
  .terminal-window::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 0.75rem;
    background: linear-gradient(135deg, var(--color-accent-glow), transparent 50%);
    z-index: -1;
    opacity: 0.5;
  }
</style>
