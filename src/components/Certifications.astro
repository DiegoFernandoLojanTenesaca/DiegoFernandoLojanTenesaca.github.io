<section id="certificaciones" class="py-16 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto">
    <div class="reveal text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">
        <span class="gradient-text" data-i18n="cert.title">Certificaciones</span>
      </h2>
      <p class="text-text-muted max-w-xl mx-auto" data-i18n="cert.subtitle">
        Formación continua en tecnología, datos e inteligencia artificial.
      </p>
    </div>

    <div class="reveal grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {certifications.map((cert) => {
        const CardTag = cert.url ? "a" : "div";
        const cardProps = cert.url
          ? { href: cert.url, target: "_blank", rel: "noopener noreferrer" }
          : {};
        return (
          <CardTag
            {...cardProps}
            class={`bg-surface border border-border rounded-xl p-5 hover:border-accent/30 transition-colors duration-300 group block ${cert.url ? "cursor-pointer" : ""}`}
          >
            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-lg bg-accent-soft flex items-center justify-center shrink-0 group-hover:bg-accent/20 transition-colors">
                <svg class="w-4.5 h-4.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconMap[cert.icon]} />
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-sm text-text font-medium leading-snug group-hover:text-accent transition-colors">
                  {cert.title}
                </p>
                <p class="text-xs text-text-muted mt-1">{cert.issuer}</p>
              </div>
              {cert.url && (
                <svg class="w-3.5 h-3.5 text-text-muted/50 group-hover:text-accent transition-colors shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              )}
            </div>
          </CardTag>
        );
      })}
    </div>
  </div>
</section>
