---
const facts = [
  { value: "3,8 MB", key: "spot.fact.size" },
  { value: "100", key: "spot.fact.species" },
  { value: "0", key: "spot.fact.requests" },
];
---

<section id="riksi" class="py-16 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
  <div class="max-w-6xl mx-auto">
    <div
      class="reveal relative rounded-2xl border border-accent-light/25 bg-surface overflow-hidden"
      style="background-image: radial-gradient(120% 90% at 88% 8%, var(--color-accent-soft), transparent 62%);"
    >
      <div class="grid lg:grid-cols-[1fr_1.05fr] gap-0 items-center">
        <div class="p-7 sm:p-10">
          <span
            class="inline-flex items-center gap-2 text-xs font-mono text-accent-light border border-accent-light/50 rounded-full px-3 py-1"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-accent timeline-dot-active"></span>
            <span data-i18n="spot.badge">Demo en vivo</span>
          </span>

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight mt-5 mb-3">
            <span class="gradient-text">Riksi</span>
          </h2>

          <p class="text-text-muted text-base sm:text-lg leading-relaxed mb-7 max-w-md" data-i18n="spot.lead">
            Apuntas la cámara a un animal o una planta y te dice qué es. El modelo se descarga
            una vez y a partir de ahí corre entero dentro del navegador, en el páramo o en
            Galápagos, donde no hay señal.
          </p>

          <dl class="spot-facts grid grid-cols-3 gap-4 mb-8 max-w-sm">
            {facts.map((f) => (
              <div>
                <dt class="text-2xl sm:text-3xl font-bold text-accent-light font-mono">{f.value}</dt>
                <dd class="text-xs text-text-muted mt-1 leading-snug" data-i18n={f.key}>
                  {f.key === "spot.fact.size" ? "el modelo entero" : f.key === "spot.fact.species" ? "especies" : "peticiones al servidor"}
                </dd>
              </div>
            ))}
          </dl>

          <div class="flex flex-wrap items-center gap-3">
            <a
              href="https://diegofernandolojantenesaca.github.io/riski/"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-2 px-6 py-3 bg-accent-light text-bg font-semibold rounded-lg hover:brightness-110 transition-all duration-300 hover:shadow-lg hover:shadow-accent/25"
            >
              <span data-i18n="spot.cta">Probar ahora</span>
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a
              href="https://github.com/DiegoFernandoLojanTenesaca/riski"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-3 border border-border text-text-muted font-medium rounded-lg hover:border-accent hover:text-accent-light transition-all duration-300"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
              <span data-i18n="spot.code">Ver el código</span>
            </a>
          </div>
        </div>

        <div class="spot-shot relative h-56 sm:h-72 lg:h-full lg:min-h-[26rem] overflow-hidden border-t lg:border-t-0 lg:border-l border-border">
          <img
            src={`${import.meta.env.BASE_URL}projects/riksi-wide.webp`}
            alt="Riksi identificando especies en el navegador"
            class="w-full h-full object-cover object-left-top"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>
