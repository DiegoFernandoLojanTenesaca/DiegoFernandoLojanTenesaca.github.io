---
import { translations } from "../data/i18n";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Diego Fernando Lojan Tenesaca | Full Stack Developer & Data/AI Engineer",
  description = "Ingeniero en Ciencias de la Computación con experiencia en desarrollo full stack, inteligencia artificial y procesamiento de datos. Construyendo soluciones escalables y orientadas a generar valor.",
} = Astro.props;

const i18nData = JSON.stringify(translations);

const ogImage = new URL(`${import.meta.env.BASE_URL}og-image.png`, Astro.site).href;
const canonical = new URL(import.meta.env.BASE_URL, Astro.site).href;
---

<!doctype html>
<html lang="es" data-theme="indigo">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Diego Fernando Lojan Tenesaca" />

    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Diego Fernando Lojan Tenesaca" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Portafolio de Diego Fernando Lojan Tenesaca" />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:locale:alternate" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Portafolio de Diego Fernando Lojan Tenesaca" />

    <!-- Fonts -->
    <link
      rel="preload"
      href={`${import.meta.env.BASE_URL}fonts/inter-latin.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={`${import.meta.env.BASE_URL}fonts/jetbrains-mono-latin.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}icon-192.png`} />
    <title>{title}</title>

    <!-- No-FOUC: aplica tema y lang guardados antes del primer paint -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("portfolio-theme");
          if (t) document.documentElement.setAttribute("data-theme", t);
          var l = localStorage.getItem("portfolio-lang");
          if (l) document.documentElement.lang = l;
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-bg text-text antialiased">
    <div class="read-progress" aria-hidden="true"></div>
    <slot />

    <!-- Scroll reveal observer -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: "0px 0px -50px 0px" }
      );

      document.querySelectorAll(".reveal, .reveal-stagger, .avatar-gesture, .timeline-line").forEach((el) => {
        observer.observe(el);
      });
    </script>


    <!-- Seccion activa en el navbar -->
    <script>
      const links = document.querySelectorAll(".nav-link");
      const byId = new Map([...links].map((a) => [a.getAttribute("href").slice(1), a]));
      const sections = [...byId.keys()].map((id) => document.getElementById(id)).filter(Boolean);

      const spy = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            links.forEach((a) => a.classList.remove("is-active"));
            byId.get(entry.target.id)?.classList.add("is-active");
          });
        },
        { rootMargin: "-45% 0px -50% 0px" }
      );

      sections.forEach((s) => spy.observe(s));
    </script>

    <!-- i18n language switcher -->
    <script define:vars={{ i18nData }}>
      const translations = JSON.parse(i18nData);

      function setLanguage(lang) {
        document.documentElement.lang = lang;
        localStorage.setItem("portfolio-lang", lang);

        document.querySelectorAll("[data-i18n]").forEach((el) => {
          const key = el.getAttribute("data-i18n");
          if (translations[key] && translations[key][lang]) {
            el.textContent = translations[key][lang];
          }
        });

        // El CV es un PDF por idioma: se cambia el href, no el texto.
        // Se reescribe el sufijo del propio href para no depender de BASE_URL.
        const cvLink = document.getElementById("cv-link");
        if (cvLink) {
          cvLink.href = cvLink.href.replace(/_(es|en)\.pdf$/, "_" + lang + ".pdf");
        }

        // Update toggle buttons
        document.querySelectorAll("#lang-toggle, #lang-toggle-mobile").forEach((btn) => {
          btn.textContent = lang.toUpperCase();
          btn.setAttribute("aria-label", (lang === "es" ? "Idioma: " : "Language: ") + lang.toUpperCase());
        });
      }

      // Load saved language
      const savedLang = localStorage.getItem("portfolio-lang") || "es";
      if (savedLang !== "es") {
        setLanguage(savedLang);
      }

      // Toggle handlers
      document.querySelectorAll("#lang-toggle, #lang-toggle-mobile").forEach((btn) => {
        btn.addEventListener("click", () => {
          const current = document.documentElement.lang || "es";
          setLanguage(current === "es" ? "en" : "es");
        });
      });
    </script>
  </body>
</html>